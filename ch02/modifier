# ── 1. 整數進位制修飾字與對齊 (#, -) ───────────────────────
print(" ── 1. 整數進位制修飾字與對齊 (#, -) ───────────────────────")
num = 125

print('帶字首預設靠右：[%#10X]' % num)         # 輸出: [      0X7D]
print('帶字首強制靠左：[%-#10X]' % num)        # 輸出: [0X7D      ]


# ── 2. 進位制與補零欄位寬度組合 ──────────────────────────
print("\n ── 2. 進位制與補零欄位寬度組合 ──────────────────────────")
color_value = 255
print('網頁色碼補零：  #[%06X]' % color_value)  # 輸出: #[0000FF]


# ── 3. 浮點數與科學記號預設靠右 ──────────────────────
print("\n ── 3. 浮點數與科學記號預設靠右 ──────────────────────")
big_number = 12345.6789
print('科學記號靠右：  [%15.2e]' % big_number) # 輸出: [       1.23e+04]


# ── 4. 科學記號總寬度與靠左對齊組合 (-) ──────────────────
print("\n ── 4. 科學記號總寬度與靠左對齊組合 (-) ──────────────────")
print('科學記號靠左：  [%-15.3e]' % big_number) # 輸出: [1.235e+04       ]


# ── 5. 新增：寬度不足（Width Insufficient）時的應變範例 ────
print("\n ── 5. 新增：寬度不足（Width Insufficient）時的應變範例 ────")
test_num = 123456

# A. 正常情況：%8d -> 寬度 8 格大於資料長度 (6格)，左邊會補 2 個空格
print('寬度充足 (8格)：[%8d]' % test_num)      # 輸出: [  123456]

# B. 寬度剛好：%6d -> 寬度 6 格剛好等於資料長度，完美貼合不留空格
print('寬度剛好 (6格)：[%6d]' % test_num)      # 輸出: [123456]

# C. 寬度不足：%3d -> 寬度設 3 格，但資料高達 6 格！
# 💡 鐵律：Python 絕對不會為了迎合寬度而破壞或截斷你的核心數據！
# 它會直接「自動無視 3 格的限制」，以資料原本的實際長度完整印出。
print('寬度不足 (3格)：[%3d]' % test_num)      # 輸出: [123456]

# D. 補零時寬度不足：%02d -> 寬度設 2 格並要求補零，但資料有 6 格
# 同理，補零功能會自動失效，優先完整呈現原始數值
print('補零但寬度不足：[%02d]' % test_num)     # 輸出: [123456]
