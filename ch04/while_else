secret_number = 7
chance = 3

while chance > 0:
    guess = int(input(f"請猜一個數字（剩餘 {chance} 次機會）: "))
    
    if guess == secret_number:
        print("🎉 恭喜你，猜對了！")
        break  # 🌟 猜對了就 break 跳出，不會執行 else
        
    print("猜錯囉，再試一次！")
    chance -= 1  # 機會減少 1
else:
    # 🌟 只有當 chance 變成 0，while 條件 (0 > 0) 不成立自然結束時，才會走到這
    print(f"❌ 遺憾，機會用盡！正確答案是 {secret_number}。")
    
secret_number = 7

# range(3) 會自動依序跑：第 1 次、第 2 次、第 3 次
for i in range(3):
    # 計算剩餘次數：3 - 0 = 3, 3 - 1 = 2, 3 - 2 = 1
    chance_left = 3 - i
    guess = int(input(f"請猜一個數字（剩餘 {chance_left} 次機會）: "))
    
    if guess == secret_number:
        print("🎉 恭喜你，猜對了！")
        break  # 🌟 猜對了就 break 跳出，不會執行 else
        
    print("猜錯囉，再試一次！")
else:
    # 🌟 3 次 range(3) 乖乖巡完都沒有被 break，代表 3 次都猜錯
    print(f"❌ 遺憾，機會用盡！正確答案是 {secret_number}。")

